# Coinbase Trading Bot Configuration
# Copy this file to .env and fill in your actual values
# Never commit .env to version control!

# Coinbase API Credentials
# Get these from: https://portal.cdp.coinbase.com/
# Note: Coinbase Advanced Trade API only requires API Key and Secret
# Passphrase is optional (only needed for legacy Coinbase Pro API)
COINBASE_API_KEY=your_api_key_here
COINBASE_API_SECRET=your_secret_here
# COINBASE_API_PASSPHRASE=  # Optional - leave empty or omit for Advanced Trade API

# Trading Configuration (optional - defaults are used if not set)
APP_ROLE=bot
TRADING_SYMBOLS=ETH/USD,BTC/USD,LINK/USD,SHIB/USD,ALGO/USD,FET/USD
TRADING_CORE_SYMBOLS=ETH/USD,BTC/USD
TRADING_TACTICAL_SYMBOLS=LINK/USD,SHIB/USD
TRADING_SPECULATIVE_SYMBOLS=ALGO/USD,FET/USD
TRADING_REGIME_SYMBOLS=BTC/USD,ETH/USD
TRADING_REGIME_TIMEFRAME=1h
TRADING_TIMEFRAME=5m
TRADING_LEVERAGE=5
TRADING_RISK_PCT=0.20
TRADING_CHECK_INTERVAL=60
TRADING_MIN_ORDER_SIZE=1.00
TRADING_COOLDOWN_MINUTES=5
TRADING_LOG_SIGNAL_CHECKS=true
TRADING_PORTFOLIO_SNAPSHOT_MINUTES=30
TRADING_JOURNAL_ENABLED=true
TRADING_JOURNAL_DB_PATH=data/trading_journal.db
REPORT_TIMEZONE=America/Los_Angeles
REPORT_RECIPIENT_EMAILS=you@example.com
REPORT_SUBJECT_PREFIX=Coinbase Bot Daily Report
# REPORT_REPLY_TO=you@example.com

# Resend email delivery
# RESEND_API_KEY=re_...
# RESEND_FROM_EMAIL=reports@yourdomain.com  # Must be on a verified Resend domain
# REPORT_REPLY_TO=you@example.com

# Optional: set DATABASE_URL for persistent Postgres logging in production
# DATABASE_URL=postgresql://...

# Profile defaults
TRADING_CORE_PROFIT_TARGET_PCT=0.030
TRADING_TACTICAL_PROFIT_TARGET_PCT=0.025
TRADING_SPECULATIVE_PROFIT_TARGET_PCT=0.020
TRADING_CORE_RISK_WEIGHT=1.00
TRADING_TACTICAL_RISK_WEIGHT=0.90
TRADING_SPECULATIVE_RISK_WEIGHT=1.20

# Portfolio Cleanup Configuration (for cleanup_portfolio.py)
MIN_POSITION_VALUE_USD=5.00  # Sell positions worth less than this amount
